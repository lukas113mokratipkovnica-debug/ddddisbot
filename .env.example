# --- Discord aplikacija (https://discord.com/developers/applications) ---
DISCORD_TOKEN=tvoj_bot_token
CLIENT_ID=application_id
CLIENT_SECRET=oauth2_client_secret

# Opcionalno: ID servera za instant registraciju slash komandi (dok testiras).
# Ako je prazno, komande se registriraju globalno (moze potrajati do 1h prvi put).
DEV_GUILD_ID=

# --- Dashboard ---
PORT=3000
# Javni URL dashboarda BEZ kose crte na kraju. Mora se poklapati s redirectom u Developer Portalu:
#   <DASHBOARD_URL>/callback
DASHBOARD_URL=http://localhost:3000
SESSION_SECRET=promijeni_ovo_u_nasumican_string_od_barem_32_znaka

# Discord ID-evi vlasnika bota (zarezom odvojeni) - imaju pristup svim serverima u dashboardu
OWNER_IDS=

# --- Platforma ---
# Ime tvoje usluge (prikazuje se na stranici i u dashboardu)
BRAND_NAME=Botnica
# Ključ za šifriranje tokena korisničkih botova. POSTAVI GA i NIKAD ga ne mijenjaj nakon
# što korisnici dodaju botove (inače se tokeni ne mogu dešifrirati). Ako je prazno, koristi SESSION_SECRET.
ENCRYPTION_KEY=
# Link na tvoj support Discord server (opcionalno)
SUPPORT_URL=

# --- Sigurnost / produkcija ---
# NODE_ENV=production uključuje stroge provjere (platforma se ne pokreće sa slabim SESSION_SECRET).
NODE_ENV=
# Broj reverse proxyja ispred aplikacije (Nginx/Caddy = 1). Bitno za ispravne IP adrese i rate limiting.
TRUST_PROXY=
