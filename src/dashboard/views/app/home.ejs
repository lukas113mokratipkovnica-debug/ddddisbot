<%- include('../partials/app-start') %>
<% const ic = (n) => `<svg class="ic"><use href="#i-${n}"/></svg>`; %>
<%- include('../partials/pagehead', { heading: 'My bots', sub: `Hi, <b>${user.username}</b> 👋 This is where you manage all your bots.`, actions: `<a class="btn btn-primary" href="/app/new">${ic('plus')}New bot</a>` }) %>

<div class="usage card">
  <div><span class="muted small">Plan</span><b><%= plan.name %></b></div>
  <div class="usage-bar"><div class="row between small"><span>Bots used</span><span><b><%= mine.length %></b> / <%= plan.maxBots %></span></div><div class="bar"><i style="width:<%= Math.min(100, mine.length / plan.maxBots * 100) %>%"></i></div></div>
  <a class="btn btn-ghost btn-sm" href="/pricing">Upgrade</a>
</div>

<% if (!mine.length) { %>
  <div class="empty card">
    <span class="empty-icon"><%- ic('bot') %></span>
    <h2>You don't have a bot yet</h2>
    <p class="muted">Create one in a minute — pick a template, paste the token, done.</p>
    <a class="btn btn-primary btn-lg" href="/app/new"><%- ic('plus') %>Create your first bot</a>
  </div>
<% } else { %>
  <div class="bot-grid">
    <% mine.forEach(b => { %><%- include('../partials/botcard', { b }) %><% }) %>
    <a class="bot-card add" href="/app/new"><%- ic('plus') %><span>Add bot</span></a>
  </div>
<% } %>

<h2 class="h2">Official bot</h2>
<p class="muted">Don't want your own bot? Add our All-in-One bot to your server and configure it here.</p>
<div class="bot-grid"><%- include('../partials/botcard', { b: official }) %></div>
<%- include('../partials/app-end') %>
