<%- include('../partials/app-start') %>
<% const ic = (n) => `<svg class="ic"><use href="#i-${n}"/></svg>`;
   const STAT = { active: ['Active','status-online'], trialing: ['Trial','status-online'], past_due: ['Payment due','status-starting'], canceled: ['Canceled','status-error'], refunded: ['Refunded','status-error'], disputed: ['Disputed payment','status-error'] };
   const suspended = bots.filter(b => b.suspended); %>
<%- include('../partials/pagehead', { heading: 'Billing & subscription', icon: 'card', sub: 'Your plan, subscription and payments.' }) %>

<% if (suspended.length) { %>
  <div class="callout callout-warn"><%- ic('pause') %><div><b>Bots paused: <%= suspended.length %>.</b> The subscription isn't active, so bots over the plan limit <b><%= plan.name %></b> stopped. Renew your subscription to bring them back.</div></div>
<% } %>

<div class="two-col">
  <div class="card" data-spot>
    <h3>Current plan</h3>
    <div class="plan-now"><span class="big-num" style="font-size:2.4rem"><%= plan.name %></span><span class="muted"><%= plan.price %> / <%= plan.period %></span></div>
    <div class="mini-stats">
      <div><b><%= bots.length %> / <%= plan.maxBots %></b><span>bots</span></div>
      <% if (subStatus) { %><div><b class="<%= (STAT[subStatus]||['',''])[1] %>" style="font-size:1rem"><%= (STAT[subStatus]||[subStatus])[0] %></b><span>subscription</span></div><% } %>
      <% if (planUntil) { %><div><b style="font-size:1rem"><%= new Date(planUntil).toLocaleDateString(numLocale) %></b><span><%= subStatus === 'active' ? 'renews' : 'valid until' %></span></div><% } %>
    </div>
    <div class="row">
      <% if (billingEnabled && hasCustomer) { %>
        <form method="post" action="/billing/portal"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-primary"><%- ic('card') %>Manage subscription</button></form>
      <% } %>
      <a class="btn btn-ghost" href="/pricing"><%- ic('crown') %><%= plan.key === 'business' ? 'All plans' : 'Upgrade plan' %></a>
    </div>
  </div>
  <div class="card" data-spot>
    <h3>How it works</h3>
    <ul class="checklist">
      <li><%- ic('check') %>You only pay for the number of bots. All modules are included in every plan.</li>
      <li><%- ic('check') %>Cancel or change your subscription anytime via "Manage subscription".</li>
      <li><%- ic('pause') %>After cancellation or a refund the plan drops to Free and bots over the limit are paused — not deleted.</li>
      <li><%- ic('check') %>As soon as you pay again, paused bots return and start automatically.</li>
    </ul>
    <% if (!billingEnabled) { %><p class="hint"><%- ic('zap') %>Online billing isn't set up on this instance — plans are assigned manually by an administrator.</p><% } %>
  </div>
</div>
<%- include('../partials/app-end') %>