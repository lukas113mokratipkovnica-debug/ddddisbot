<%- include('../partials/app-start') %>
<%- include('../partials/pagehead', { heading: 'Konzola', icon: 'terminal', sub: 'Zadnjih 200 događaja ovog bota, uživo.' }) %>
<div class="console card" id="console" data-console="<%= botRec.id %>" data-max="200">
  <% logs.forEach(l => { %><div class="log-line log-<%= l.level %>"><time><%= new Date(l.t).toLocaleTimeString(numLocale) %></time><b><%= l.level %></b><span><%= l.msg %></span></div><% }) %>
  <% if (!logs.length) { %><div class="muted">Nema zapisa.</div><% } %>
</div>
<%- include('../partials/app-end') %>
