<%- include('../partials/app-start') %>
<% const ic = (n) => `<svg class="ic"><use href="#i-${n}"/></svg>`; %>
<%- include('../partials/pagehead', { heading: 'New bot', sub: 'Pick a template, connect a Discord application and the bot is online.' }) %>
<% if (limitReached) { %>
  <div class="callout callout-warn"><%- ic('crown') %><div><b>You've reached your plan limit (<%= plan.maxBots %>).</b> Delete an existing bot or upgrade your plan.</div><a class="btn btn-sm btn-primary" href="/pricing">Paketi</a></div>
<% } %>
<form method="post" action="/app/new" class="wizard">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="wizard-step">
    <div class="step-label"><span>1</span>Choose a bot</div>
    <div class="tpl-pick">
      <% Object.entries(TEMPLATES).forEach(([key, t], idx) => { %>
        <label class="tpl-option" style="--c:<%= t.color %>">
          <input type="radio" name="template" value="<%= key %>" <%= (template ? template === key : idx === 0) ? 'checked' : '' %>>
          <span class="tpl-option-body">
            <span class="tpl-icon"><%- ic(t.icon) %></span>
            <b><%= t.name %></b>
            <small><%= t.tagline %></small>
            <span class="tpl-count"><%= t.modules.length %> modules</span>
          </span>
        </label>
      <% }) %>
    </div>
  </div>

  <div class="wizard-step">
    <div class="step-label"><span>2</span>Create a Discord application</div>
    <div class="guide card">
      <ol>
        <li>Open <a href="https://discord.com/developers/applications" target="_blank" rel="noopener">Discord Developer Portal <%- ic('external') %></a> → <b>New Application</b> and give it a name.</li>
        <li>On the left, open <b>Bot</b>. You can set the avatar and name here.</li>
        <li>Under <b>Privileged Gateway Intents</b> enable <span class="kbd">Server Members Intent</span> and <span class="kbd">Message Content Intent</span>, then click <b>Save</b>.</li>
        <li>Click <b>Reset Token</b>, confirm and copy the token.</li>
      </ol>
    </div>
  </div>

  <div class="wizard-step">
    <div class="step-label"><span>3</span>Paste the token</div>
    <div class="card">
      <label>Bot token
        <div class="input-icon"><%- ic('key') %><input type="password" name="token" required autocomplete="off" spellcheck="false" placeholder="MTEx…" <%= limitReached ? 'disabled' : '' %>></div>
      </label>
      <p class="hint"><%- ic('lock') %> The token is stored encrypted and never shown. Never share it with anyone.</p>
      <button class="btn btn-primary btn-lg" <%= limitReached ? 'disabled' : '' %> data-loading="Starting the bot…"><%- ic('zap') %>Create and start the bot</button>
    </div>
  </div>
</form>
<%- include('../partials/app-end') %>
