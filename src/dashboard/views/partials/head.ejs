<!doctype html>
<html lang="hr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' • ' : '' %><%= bot ? bot.username : 'Bot' %> Dashboard</title>
  <link rel="icon" href="<%= bot ? bot.displayAvatarURL({ size: 64 }) : '' %>">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header class="topbar">
  <a class="brand" href="/">
    <% if (bot) { %><img src="<%= bot.displayAvatarURL({ size: 64 }) %>" alt=""><% } %>
    <span><%= bot ? bot.username : 'Bot' %></span>
  </a>
  <nav class="topnav">
    <a href="/dashboard">Serveri</a>
    <a href="<%= inviteUrl %>" target="_blank" rel="noopener">Dodaj bota</a>
    <% if (user) { %>
      <span class="me"><img src="<%= user.avatar %>" alt=""><%= user.username %></span>
      <a class="btn btn-ghost btn-sm" href="/logout">Odjava</a>
    <% } else { %>
      <a class="btn btn-primary btn-sm" href="/login">Prijava s Discordom</a>
    <% } %>
  </nav>
</header>
<% if (flash) { %>
  <div class="flash flash-<%= flash.type %>" id="flash"><%= flash.msg %></div>
<% } %>
