<!doctype html>
<html lang="<%= lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? t(title) + ' · ' : '' %><%= brand %></title>
  <meta name="description" content="<%= brand %> — napravi vlastitog Discord bota bez kodiranja. Moderacija, leveling, ekonomija, tiketi, giveaway i još 20+ modula.">
  <meta name="theme-color" content="#14111f">
  <% if (brandLogo) { %><link rel="icon" href="<%= brandLogo %>"><% } %>
  <script src="/static/theme.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<%- include('icons') %>
<% if (flash) { %><div class="toast toast-<%= flash.type %>" id="toast" role="status"><span class="toast-icon"><svg class="ic"><use href="#i-<%= flash.type === 'success' ? 'check' : 'zap' %>"/></svg></span><span><%= flash.msg %></span></div><% } %>
