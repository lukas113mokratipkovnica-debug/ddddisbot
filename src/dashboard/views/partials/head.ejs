<!doctype html>
<html lang="hr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %><%= brand %></title>
  <meta name="description" content="<%= brand %> — napravi vlastitog Discord bota bez kodiranja. Moderacija, leveling, ekonomija, tiketi, giveaway i još 20+ modula.">
  <% if (brandLogo) { %><link rel="icon" href="<%= brandLogo %>"><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
</head>
<body class="<%= typeof bodyClass !== 'undefined' ? bodyClass : '' %>">
<%- include('icons') %>
<% if (flash) { %><div class="toast toast-<%= flash.type %>" id="toast" role="status"><svg class="ic"><use href="#i-<%= flash.type === 'success' ? 'check' : 'zap' %>"/></svg><span><%= flash.msg %></span></div><% } %>
