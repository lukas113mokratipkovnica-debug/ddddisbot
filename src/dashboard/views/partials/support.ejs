<div class="sup" id="sup" data-csrf="<%= csrf %>">
  <button class="sup-fab" type="button" data-sup-open aria-label="Support"><svg class="ic"><use href="#i-life-buoy"/></svg></button>
  <div class="sup-panel" role="dialog" aria-label="AI support" hidden>
    <div class="sup-head"><span class="sup-title"><span class="sup-avatar"><svg class="ic"><use href="#i-sparkles"/></svg></span><b>AI support</b><i class="sup-badge" data-sup-badge></i></span><button class="icon-btn" type="button" data-sup-close aria-label="Close"><svg class="ic"><use href="#i-x"/></svg></button></div>
    <div class="sup-body" data-sup-body><div class="sup-msg bot">Hi! 👋 I'm the AI support assistant. Ask me anything about the platform — how to create a bot, why it's offline, plans, billing…</div></div>
    <form class="sup-input" data-sup-form><input type="text" placeholder="Type a question…" autocomplete="off" maxlength="2000" required><button class="icon-btn" type="submit" aria-label="Send"><svg class="ic"><use href="#i-send"/></svg></button></form>
  </div>
</div>