<div class="sup" id="sup" data-csrf="<%= csrf %>">
  <button class="sup-fab" type="button" data-sup-open aria-label="Podrška"><svg class="ic"><use href="#i-life-buoy"/></svg></button>
  <div class="sup-panel" role="dialog" aria-label="AI podrška" hidden>
    <div class="sup-head"><span class="sup-title"><span class="sup-avatar"><svg class="ic"><use href="#i-sparkles"/></svg></span><b>AI podrška</b><i class="sup-badge" data-sup-badge></i></span><button class="icon-btn" type="button" data-sup-close aria-label="Zatvori"><svg class="ic"><use href="#i-x"/></svg></button></div>
    <div class="sup-body" data-sup-body><div class="sup-msg bot">Bok! 👋 Ja sam AI asistent podrške. Pitaj me bilo što o platformi — kako napraviti bota, zašto je offline, paketi, naplata…</div></div>
    <form class="sup-input" data-sup-form><input type="text" placeholder="Napiši pitanje…" autocomplete="off" maxlength="2000" required><button class="icon-btn" type="submit" aria-label="Pošalji"><svg class="ic"><use href="#i-send"/></svg></button></form>
  </div>
</div>