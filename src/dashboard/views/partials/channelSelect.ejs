<select name="<%= name %>" <%= typeof required !== 'undefined' && required ? 'required' : '' %>>
  <option value=""><%= typeof placeholder !== 'undefined' ? placeholder : '— choose a channel —' %></option>
  <% (typeof list !== 'undefined' ? list : channels).forEach(c => { %>
    <option value="<%= c.id %>" <%= value === c.id ? 'selected' : '' %>><%= c.parent ? c.parent + ' › ' : '' %><%= typeof voice !== 'undefined' && voice ? '🔊 ' : '#' %><%= c.name %></option>
  <% }) %>
</select>
