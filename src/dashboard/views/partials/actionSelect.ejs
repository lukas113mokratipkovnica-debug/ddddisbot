<select name="<%= name %>">
  <option value="delete" <%= value === 'delete' ? 'selected' : '' %>>Delete message</option>
  <option value="warn" <%= value === 'warn' ? 'selected' : '' %>>Delete + warning</option>
  <option value="timeout" <%= value === 'timeout' ? 'selected' : '' %>>Delete + timeout</option>
</select>
