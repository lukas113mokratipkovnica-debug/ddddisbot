<%- include('partials/head', { bodyClass: 'site' }) %>
<%- include('partials/site-nav') %>
<% const ic = (n) => `<svg class="ic"><use href="#i-${n}"/></svg>`; const tpl = Object.entries(TEMPLATES); %>

<section class="hero">
  <div class="hero-glow"></div>
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <span class="pill"><%- ic('sparkles') %> <%= stats.modules %> modula · <%= stats.commands %> komandi · 0 linija koda</span>
      <h1>Tvoj Discord bot.<br><span class="grad">Online za 60 sekundi.</span></h1>
      <p class="lead">Odaberi gotovog bota — moderator, leveling, ekonomija, tiketi, giveaway i još desetak — zalijepi token i bot radi 24/7. Sve podešavaš klikom u dashboardu.</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="<%= user ? '/app/new' : '/login' %>"><%- ic('plus') %>Napravi bota besplatno</a>
        <a class="btn btn-ghost btn-lg" href="/catalog">Pogledaj botove <%- ic('arrow-right') %></a>
      </div>
      <div class="hero-proof">
        <div><b data-count="<%= stats.bots %>"><%= stats.bots %></b><span>botova</span></div>
        <div><b data-count="<%= stats.guilds %>"><%= stats.guilds %></b><span>servera</span></div>
        <div><b data-count="<%= stats.members %>"><%= stats.members %></b><span>korisnika</span></div>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="mock">
        <div class="mock-bar"><i></i><i></i><i></i><span>dashboard</span></div>
        <div class="mock-body">
          <div class="mock-side"><% ['grid','layers','settings','terminal'].forEach(n => { %><span><%- ic(n) %></span><% }) %></div>
          <div class="mock-main">
            <% [['Moderator','shield','#ef4444','Online'],['Leveling','trending','#22c55e','Online'],['Ekonomija','coins','#eab308','Online']].forEach(([n,i,c,s]) => { %>
              <div class="mock-card"><span class="tpl-icon" style="--c:<%= c %>"><%- ic(i) %></span><div><b><%= n %> bot</b><small><i class="dot dot-online"></i><%= s %> · 12 servera</small></div><span class="mock-toggle on"></span></div>
            <% }) %>
            <div class="mock-chart"><% [40,65,45,80,60,95,75,88,70,100].forEach(h => { %><i style="height:<%= h %>%"></i><% }) %></div>
          </div>
        </div>
      </div>
      <div class="float-card fc-1"><%- ic('check') %> Korisnik verificiran</div>
      <div class="float-card fc-2"><%- ic('trending') %> GG! Level 12 🚀</div>
    </div>
  </div>
</section>

<section class="section" id="botovi">
  <div class="wrap">
    <div class="section-head"><span class="eyebrow">Botovi</span><h2>Odaberi bota koji ti treba</h2><p class="muted">Svaki bot je gotov predložak. Kasnije možeš uključiti bilo koji drugi modul — jedan bot može sve.</p></div>
    <div class="tpl-grid">
      <% tpl.forEach(([key, t]) => { %>
        <a class="tpl-card" href="<%= user ? '/app/new?template=' + key : '/login' %>" style="--c:<%= t.color %>">
          <span class="tpl-icon"><%- ic(t.icon) %></span>
          <h3><%= t.name %> bot</h3>
          <p><%= t.desc %></p>
          <div class="tpl-mods"><% t.modules.slice(0, 4).forEach(m => { %><span><%= MODULES[m].name %></span><% }) %><% if (t.modules.length > 4) { %><span>+<%= t.modules.length - 4 %></span><% } %></div>
          <span class="tpl-go">Odaberi <%- ic('arrow-right') %></span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section alt">
  <div class="wrap">
    <div class="section-head"><span class="eyebrow">Kako radi</span><h2>Tri koraka do tvog bota</h2></div>
    <div class="steps">
      <div class="step"><span class="step-n">1</span><h3>Napravi aplikaciju</h3><p>U Discord Developer Portalu napravi aplikaciju, uključi dva intenta i kopiraj token. Vodimo te korak po korak.</p></div>
      <div class="step"><span class="step-n">2</span><h3>Odaberi bota</h3><p>Zalijepi token, odaberi predložak i bot je online odmah. Hostamo ga mi — bez servera, bez koda.</p></div>
      <div class="step"><span class="step-n">3</span><h3>Podesi sve klikom</h3><p>Uključi module, podesi kanale, poruke, uloge i automatizaciju za svaki server posebno.</p></div>
    </div>
  </div>
</section>

<section class="section" id="moduli">
  <div class="wrap">
    <div class="section-head"><span class="eyebrow">Moduli</span><h2><%= stats.modules %> modula, jedan dashboard</h2><p class="muted">Uključi samo ono što ti treba. Slash komande se ažuriraju automatski.</p></div>
    <div class="mod-grid">
      <% Object.entries(MODULES).forEach(([key, m]) => { %>
        <div class="mod-card"><span class="mod-icon"><%- ic(m.icon) %></span><div><h4><%= m.name %></h4><p><%= m.desc %></p></div></div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section alt" id="cijene">
  <div class="wrap">
    <div class="section-head"><span class="eyebrow">Cijene</span><h2>Počni besplatno. Raste s tobom.</h2></div>
    <%- include('partials/plans') %>
  </div>
</section>

<section class="section" id="faq">
  <div class="wrap narrow">
    <div class="section-head"><span class="eyebrow">FAQ</span><h2>Česta pitanja</h2></div>
    <%- include('partials/faq') %>
  </div>
</section>

<section class="cta-band">
  <div class="wrap cta-inner">
    <h2>Spreman/na za svog bota?</h2>
    <a class="btn btn-light btn-lg" href="<%= user ? '/app/new' : '/login' %>">Započni besplatno <%- ic('arrow-right') %></a>
  </div>
</section>
<%- include('partials/site-footer') %>
<%- include('partials/foot') %>
