<%- include('partials/head', { bodyClass: 'site' }) %>
<%- include('partials/site-nav') %>
<section class="error-page"><div class="wrap narrow center">
  <div class="error-code grad"><%= /^\d+$/.test(title) ? title : '!' %></div>
  <h1><%= /^\d+$/.test(title) ? (title === '404' ? 'Stranica ne postoji' : 'Polako!') : title %></h1>
  <p class="lead muted" style="margin:0 auto"><%= message %></p>
  <div class="hero-actions center"><a class="btn btn-primary" href="/app">Natrag na dashboard</a><a class="btn btn-ghost" href="/">Početna</a></div>
</div></section>
<%- include('partials/foot') %>
