<%- include('../partials/app-start') %>
<% const A = settings.automod; %>
<%- include('../partials/pagehead', { heading: 'AutoMod', icon: 'bot', sub: 'Members with the <b>Manage Messages</b> permission are automatically exempt.' }) %>
<form method="post" action="<%= base %>/save/automod">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="card">
    <%- include('../partials/toggle', { name: 'enabled', checked: A.enabled, label: 'AutoMod enabled' }) %>
    <label>Timeout duration (minutes)<input type="number" name="timeoutMinutes" min="1" max="40320" value="<%= A.timeoutMinutes %>"></label>
  </div>
  <div class="rules">
    <div class="card">
      <h3>🤬 Banned words</h3>
      <%- include('../partials/toggle', { name: 'badWordsEnabled', checked: A.badWords.enabled, label: 'Enabled' }) %>
      <label>Words (one per line or comma-separated; <code>*</code> = anything, e.g. <code>damn*</code>)<textarea name="badWords" rows="5"><%= A.badWords.words.join('\n') %></textarea></label>
      <label>Action<%- include('../partials/actionSelect', { name: 'badWordsAction', value: A.badWords.action }) %></label>
    </div>
    <div class="card">
      <h3>📨 Discord invites</h3>
      <%- include('../partials/toggle', { name: 'invitesEnabled', checked: A.invites.enabled, label: 'Block other servers\' invite links' }) %>
      <label>Action<%- include('../partials/actionSelect', { name: 'invitesAction', value: A.invites.action }) %></label>
    </div>
    <div class="card">
      <h3>🔗 Links</h3>
      <%- include('../partials/toggle', { name: 'linksEnabled', checked: A.links.enabled, label: 'Block links' }) %>
      <label>Allowed domains<textarea name="linksWhitelist" rows="3"><%= A.links.whitelist.join('\n') %></textarea></label>
      <label>Action<%- include('../partials/actionSelect', { name: 'linksAction', value: A.links.action }) %></label>
    </div>
    <div class="card">
      <h3>📣 Mass mentions</h3>
      <%- include('../partials/toggle', { name: 'mentionsEnabled', checked: A.mentions.enabled, label: 'Enabled' }) %>
      <label>Max mentions per message<input type="number" name="mentionsLimit" min="2" max="50" value="<%= A.mentions.limit %>"></label>
      <label>Action<%- include('../partials/actionSelect', { name: 'mentionsAction', value: A.mentions.action }) %></label>
    </div>
    <div class="card">
      <h3>🔠 Caps lock</h3>
      <%- include('../partials/toggle', { name: 'capsEnabled', checked: A.caps.enabled, label: 'Enabled' }) %>
      <div class="grid2">
        <label>% uppercase letters<input type="number" name="capsPercent" min="30" max="100" value="<%= A.caps.percent %>"></label>
        <label>Min. length<input type="number" name="capsMin" min="5" max="200" value="<%= A.caps.minLength %>"></label>
      </div>
      <label>Action<%- include('../partials/actionSelect', { name: 'capsAction', value: A.caps.action }) %></label>
    </div>
    <div class="card">
      <h3>⚡ Spam</h3>
      <%- include('../partials/toggle', { name: 'spamEnabled', checked: A.spam.enabled, label: 'Enabled' }) %>
      <div class="grid2">
        <label>More than X messages<input type="number" name="spamMessages" min="2" max="30" value="<%= A.spam.messages %>"></label>
        <label>in Y seconds<input type="number" name="spamSeconds" min="1" max="60" value="<%= A.spam.seconds %>"></label>
      </div>
      <label>Action<%- include('../partials/actionSelect', { name: 'spamAction', value: A.spam.action }) %></label>
    </div>
  </div>
  <div class="card">
    <h3>⚖️ Automatic punishment for warnings</h3>
    <p class="hint">Applies to /warn and AutoMod warnings. Triggers on every X warnings.</p>
    <%- include('../partials/toggle', { name: 'thresholdEnabled', checked: A.warnThreshold.enabled, label: 'Enabled' }) %>
    <div class="grid3">
      <label>Number of warnings<input type="number" name="thresholdCount" min="1" max="50" value="<%= A.warnThreshold.count %>"></label>
      <label>Punishment<select name="thresholdAction">
        <% ['timeout','kick','ban'].forEach(a => { %><option value="<%= a %>" <%= A.warnThreshold.action === a ? 'selected' : '' %>><%= a %></option><% }) %>
      </select></label>
      <label>Timeout (min)<input type="number" name="thresholdMinutes" min="1" max="40320" value="<%= A.warnThreshold.minutes %>"></label>
    </div>
  </div>
  <div class="card">
    <h3>Exceptions</h3>
    <div class="grid2">
      <div><b>Ignored channels</b><%- include('../partials/multi', { name: 'ignoredChannels', kind: 'channel', values: A.ignoredChannels }) %></div>
      <div><b>Ignored roles</b><%- include('../partials/multi', { name: 'ignoredRoles', kind: 'role', values: A.ignoredRoles }) %></div>
    </div>
  </div>
  <%- include('../partials/saveBar') %>
</form>
<%- include('../partials/app-end') %>
