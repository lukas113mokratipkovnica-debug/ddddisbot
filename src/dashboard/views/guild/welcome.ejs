<%- include('../partials/app-start') %>
<%- include('../partials/pagehead', { heading: 'Welcome & autoroles', icon: 'hand', sub: 'Join and leave messages, automatic roles and invites.' }) %>
<% if (modules.has('welcome')) { %>
<form method="post" action="<%= base %>/save/welcome">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="card">
    <h3>👋 Welcome message</h3>
    <%- include('../partials/toggle', { name: 'welcomeEnabled', checked: settings.welcome.enabled, label: 'Enabled' }) %>
    <label>Channel<%- include('../partials/channelSelect', { name: 'welcomeChannel', value: settings.welcome.channel }) %></label>
    <label>Message<textarea name="welcomeMessage" rows="3"><%= settings.welcome.message %></textarea></label>
    <%- include('../partials/placeholders') %>
    <%- include('../partials/toggle', { name: 'welcomeEmbed', checked: settings.welcome.embed, label: 'Send as an embed (with avatar)' }) %>
    <%- include('../partials/toggle', { name: 'welcomeDm', checked: settings.welcome.dm, label: 'Also send a private message (DM)' }) %>
    <label>DM message<textarea name="welcomeDmMessage" rows="2"><%= settings.welcome.dmMessage %></textarea></label>
  </div>
  <div class="card">
    <h3>🚪 Leave message</h3>
    <%- include('../partials/toggle', { name: 'goodbyeEnabled', checked: settings.goodbye.enabled, label: 'Enabled' }) %>
    <label>Channel<%- include('../partials/channelSelect', { name: 'goodbyeChannel', value: settings.goodbye.channel }) %></label>
    <label>Message<textarea name="goodbyeMessage" rows="2"><%= settings.goodbye.message %></textarea></label>
    <%- include('../partials/toggle', { name: 'goodbyeEmbed', checked: settings.goodbye.embed, label: 'Send as an embed' }) %>
  </div>
  <div class="card">
    <h3>🎭 Autoroles</h3>
    <%- include('../partials/toggle', { name: 'autoroleEnabled', checked: settings.autorole.enabled, label: 'Enabled' }) %>
    <div class="grid2">
      <div><b>Roles for new members</b><%- include('../partials/multi', { name: 'autoroleRoles', kind: 'role', values: settings.autorole.roles }) %></div>
      <div><b>Roles for new bots</b><%- include('../partials/multi', { name: 'autoroleBotRoles', kind: 'role', values: settings.autorole.botRoles }) %></div>
    </div>
    <p class="hint">The bot can only assign roles below its highest role.</p>
  </div>
  <%- include('../partials/saveBar') %>
</form>
<% } %>
<% if (modules.has('invites')) { %>
<form method="post" action="<%= base %>/save/invites">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="card">
    <h3>📨 Invite tracking</h3>
    <p class="hint">The bot needs the <b>Manage Server</b> to see invites. In the welcome message you can also use <code>{inviter}</code> and <code>{invites}</code>.</p>
    <%- include('../partials/toggle', { name: 'enabled', checked: settings.invites.enabled, label: 'A separate message about who invited whom' }) %>
    <label>Channel<%- include('../partials/channelSelect', { name: 'channel', value: settings.invites.channel }) %></label>
    <label>Message<textarea name="message" rows="2"><%= settings.invites.message %></textarea></label>
    <%- include('../partials/placeholders', { extra: '<code>{inviter}</code> <code>{invites}</code>' }) %>
    <button class="btn btn-primary">Save</button>
  </div>
</form>
<div class="card">
  <h3>Top inviters</h3>
  <% if (!inviteTop.length) { %><p class="muted">No data yet.</p><% } else { %>
  <table class="table"><thead><tr><th>#</th><th>Member</th><th>Total</th><th>Joined</th><th>Left</th></tr></thead><tbody>
    <% inviteTop.forEach((r, i) => { %><tr><td><%= i + 1 %></td><td class="user"><img src="<%= userAvatar(r.user_id) %>" alt=""><%= userName(r.user_id) %></td><td><b><%= r.total %></b></td><td><%= r.joins %></td><td><%= r.leaves %></td></tr><% }) %>
  </tbody></table><% } %>
</div>
<% } %>
<%- include('../partials/app-end') %>
