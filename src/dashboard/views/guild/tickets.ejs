<%- include('../partials/app-start') %>
<% const T = settings.tickets; %>
<%- include('../partials/pagehead', { heading: 'Tickets', icon: 'ticket', sub: 'Private support channels with transcripts.' }) %>
<form method="post" action="<%= base %>/save/tickets">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="card">
    <%- include('../partials/toggle', { name: 'enabled', checked: T.enabled, label: 'Tickets enabled' }) %>
    <div class="grid3">
      <label>Ticket category<select name="category"><option value="">— no category —</option><% categories.forEach(c => { %><option value="<%= c.id %>" <%= T.category === c.id ? 'selected' : '' %>>📁 <%= c.name %></option><% }) %></select></label>
      <label>Transcript channel<%- include('../partials/channelSelect', { name: 'logChannel', value: T.logChannel, placeholder: '— use the log channel —' }) %></label>
      <label>Max open per member<input type="number" name="maxOpen" min="1" max="10" value="<%= T.maxOpen %>"></label>
    </div>
    <b>Support roles (see all tickets)</b>
    <%- include('../partials/multi', { name: 'supportRoles', kind: 'role', values: T.supportRoles }) %>
  </div>
  <div class="card">
    <h3>Appearance</h3>
    <label>Panel title<input name="panelTitle" maxlength="256" value="<%= T.panelTitle %>"></label>
    <label>Panel description<textarea name="panelDescription" rows="3"><%= T.panelDescription %></textarea></label>
    <label>Message in a new ticket<textarea name="welcomeMessage" rows="2"><%= T.welcomeMessage %></textarea></label>
    <%- include('../partials/placeholders') %>
  </div>
  <%- include('../partials/saveBar') %>
</form>
<div class="card">
  <h3>Send panel</h3>
  <form method="post" action="<%= base %>/tickets/panel" class="row">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <%- include('../partials/channelSelect', { name: 'channel', value: '', required: true }) %>
    <button class="btn btn-primary">Send</button>
  </form>
</div>
<div class="card">
  <h3>Recent tickets</h3>
  <% if (!ticketList.length) { %><p class="muted">No tickets.</p><% } else { %>
  <table class="table"><thead><tr><th>#</th><th>Member</th><th>Topic</th><th>Status</th><th>Otvoren</th></tr></thead><tbody>
    <% ticketList.forEach(t => { %><tr><td><%= t.number %></td><td class="user"><img src="<%= userAvatar(t.user_id) %>" alt=""><%= userName(t.user_id) %></td><td class="clip"><%= t.topic || '—' %></td><td><span class="tag tag-<%= t.status === 'open' ? 'unban' : 'ban' %>"><%= t.status === 'open' ? 'otvoren' : 'zatvoren' %></span></td><td><%= new Date(t.created_at).toLocaleString(numLocale) %></td></tr><% }) %>
  </tbody></table><% } %>
</div>
<%- include('../partials/app-end') %>
