<%- include('../partials/app-start') %>
<% const V = settings.verification; %>
<%- include('../partials/pagehead', { heading: 'Verification', icon: 'badge', sub: 'New members must click a button (and type a code) before they get access to the server.' }) %>
<form method="post" action="<%= base %>/save/verification">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="card">
    <%- include('../partials/toggle', { name: 'enabled', checked: V.enabled, label: 'Verification enabled' }) %>
    <%- include('../partials/toggle', { name: 'captcha', checked: V.captcha, label: 'Captcha code', hint: 'The member must type a random code — stops most bots.' }) %>
    <div class="grid2">
      <label>Role after verification<%- include('../partials/roleSelect', { name: 'role', value: V.role, assignableOnly: true }) %></label>
      <label>Remove role (optional)<%- include('../partials/roleSelect', { name: 'removeRole', value: V.removeRole, placeholder: '— nothing —', assignableOnly: true }) %></label>
    </div>
  </div>
  <div class="card">
    <h3>Panel appearance</h3>
    <label>Title<input name="title" maxlength="256" value="<%= V.title %>"></label>
    <label>Message<textarea name="message" rows="3"><%= V.message %></textarea></label>
  </div>
  <%- include('../partials/saveBar') %>
</form>
<div class="card">
  <h3>Send panel</h3>
  <p class="hint">Tip: lock all channels for <code>@everyone</code>, and open them for the verified role. Put the panel in a channel visible only to <code>@everyone</code>.</p>
  <form method="post" action="<%= base %>/verification/panel" class="row">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <%- include('../partials/channelSelect', { name: 'channel', value: '', required: true }) %>
    <button class="btn btn-primary">Send panel</button>
  </form>
</div>
<%- include('../partials/app-end') %>
