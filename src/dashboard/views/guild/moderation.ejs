<%- include('../partials/app-start') %>
<%- include('../partials/pagehead', { heading: 'Moderation', icon: 'shield' }) %>
<p class="muted">Commands: <code>/ban</code> <code>/unban</code> <code>/kick</code> <code>/timeout</code> <code>/untimeout</code> <code>/warn</code> <code>/warnings</code> <code>/delwarn</code> <code>/purge</code> <code>/slowmode</code> <code>/lock</code> <code>/unlock</code> <code>/nick</code> <code>/role</code>. Automatic warning punishments are configured in <a href="<%= base %>/automod">AutoMod</a>.</p>
<div class="card">
  <h3>Warnings (<%= warningList.length %>)</h3>
  <input type="search" class="table-filter" data-target="warn-table" placeholder="Filter by member or reason…">
  <% if (!warningList.length) { %><p class="muted">No warnings.</p><% } else { %>
  <table class="table" id="warn-table"><thead><tr><th>ID</th><th>Member</th><th>Moderator</th><th>Reason</th><th>Date</th><th></th></tr></thead><tbody>
    <% warningList.forEach(w => { %>
      <tr><td><%= w.id %></td><td class="user"><img src="<%= userAvatar(w.user_id) %>" alt=""><%= userName(w.user_id) %></td><td><%= userName(w.mod_id) %></td><td class="clip"><%= w.reason || '—' %></td><td><%= new Date(w.created_at).toLocaleDateString(numLocale) %></td>
        <td><form method="post" action="<%= base %>/warnings/<%= w.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-xs">Delete</button></form></td></tr>
    <% }) %>
  </tbody></table><% } %>
</div>
<div class="card">
  <h3>Mod cases</h3>
  <% if (!caseList.length) { %><p class="muted">No cases.</p><% } else { %>
  <table class="table"><thead><tr><th>#</th><th>Type</th><th>Member</th><th>Moderator</th><th>Reason</th><th>Date</th></tr></thead><tbody>
    <% caseList.forEach(c => { %><tr><td><%= c.id %></td><td><span class="tag tag-<%= c.type %>"><%= c.type %></span></td><td><%= userName(c.user_id) %></td><td><%= userName(c.mod_id) %></td><td class="clip"><%= c.reason || '—' %></td><td><%= new Date(c.created_at).toLocaleString(numLocale) %></td></tr><% }) %>
  </tbody></table><% } %>
</div>
<%- include('../partials/app-end') %>
