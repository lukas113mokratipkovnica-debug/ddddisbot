<%- include('../partials/app-start') %>
<%- include('../partials/pagehead', { heading: 'Community', icon: 'users', sub: 'Starboard, suggestions, anonymous confessions, a counting game and birthdays.' }) %>
<div class="two-col">
<% if (modules.has('starboard')) { const S = settings.starboard; %>
  <form class="card" method="post" action="<%= base %>/save/starboard">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h3>⭐ Starboard</h3>
    <%- include('../partials/toggle', { name: 'enabled', checked: S.enabled, label: 'Enabled' }) %>
    <label>Channel<%- include('../partials/channelSelect', { name: 'channel', value: S.channel }) %></label>
    <div class="grid2"><label>Emoji<input name="emoji" value="<%= S.emoji %>" maxlength="64"></label><label>Reactions needed<input type="number" name="threshold" min="1" max="100" value="<%= S.threshold %>"></label></div>
    <button class="btn btn-primary">Save</button>
  </form>
<% } %>
<% if (modules.has('suggestions')) { const S = settings.suggestions; %>
  <form class="card" method="post" action="<%= base %>/save/suggestions">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h3>💡 Suggestions</h3>
    <p class="hint">Members use <code>/suggest</code>. The bot adds ✅/❌ and opens a thread.</p>
    <%- include('../partials/toggle', { name: 'enabled', checked: S.enabled, label: 'Enabled' }) %>
    <label>Suggestions channel<%- include('../partials/channelSelect', { name: 'channel', value: S.channel }) %></label>
    <button class="btn btn-primary">Save</button>
  </form>
<% } %>
<% if (modules.has('confessions')) { const C = settings.confessions; %>
  <form class="card" method="post" action="<%= base %>/save/confessions">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h3>🎭 Anonymous confessions</h3>
    <p class="hint"><code>/confess</code> sends an anonymous message. The log channel (moderators only) records the author.</p>
    <%- include('../partials/toggle', { name: 'enabled', checked: C.enabled, label: 'Enabled' }) %>
    <label>Public channel<%- include('../partials/channelSelect', { name: 'channel', value: C.channel }) %></label>
    <label>Log channel (private)<%- include('../partials/channelSelect', { name: 'logChannel', value: C.logChannel, placeholder: '— no log —' }) %></label>
    <button class="btn btn-primary">Save</button>
  </form>
<% } %>
<% if (modules.has('counting')) { const C = settings.counting; %>
  <form class="card" method="post" action="<%= base %>/save/counting">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h3>🔢 Counting</h3>
    <div class="mini-stats"><div><b><%= countState.current %></b><span>current</span></div><div><b><%= countState.high_score %></b><span>high score</span></div></div>
    <%- include('../partials/toggle', { name: 'enabled', checked: C.enabled, label: 'Enabled' }) %>
    <label>Channel<%- include('../partials/channelSelect', { name: 'channel', value: C.channel }) %></label>
    <%- include('../partials/toggle', { name: 'sameUserTwice', checked: C.sameUserTwice, label: 'Allow the same person twice in a row' }) %>
    <%- include('../partials/toggle', { name: 'resetOnFail', checked: C.resetOnFail, label: 'Restart from 1 after a mistake' }) %>
    <div class="row"><button class="btn btn-primary">Save</button><button class="btn btn-ghost" formaction="<%= base %>/counting/reset" data-confirm="Reset to 0?">Reset counter</button></div>
  </form>
<% } %>
<% if (modules.has('birthdays')) { const B = settings.birthdays; %>
  <form class="card" method="post" action="<%= base %>/save/birthdays">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <h3>🎂 Birthdays</h3>
    <p class="hint">Members set their birthday with <code>/birthday set</code>. Set: <b><%= birthdayList.length %></b>.</p>
    <%- include('../partials/toggle', { name: 'enabled', checked: B.enabled, label: 'Enabled' }) %>
    <label>Channel for wishes<%- include('../partials/channelSelect', { name: 'channel', value: B.channel }) %></label>
    <label>Birthday role (that day)<%- include('../partials/roleSelect', { name: 'role', value: B.role, placeholder: '— no role —', assignableOnly: true }) %></label>
    <label>Message<textarea name="message" rows="2"><%= B.message %></textarea></label>
    <button class="btn btn-primary">Save</button>
  </form>
<% } %>
</div>
<% if (modules.has('confessions') && confessionList.length) { %>
  <div class="card"><h3>Zadnje ispovijesti</h3>
    <div class="table-wrap"><table class="table"><thead><tr><th>Author</th><th>Text</th><th>Date</th></tr></thead><tbody>
      <% confessionList.forEach(c => { %><tr><td><%= userName(c.user_id) %></td><td class="clip"><%= c.content %></td><td><%= new Date(c.created_at).toLocaleString(numLocale) %></td></tr><% }) %>
    </tbody></table></div></div>
<% } %>
<%- include('../partials/app-end') %>
