<%- include('../partials/app-start') %>
<%- include('../partials/pagehead', { heading: 'Voice', icon: 'mic', sub: 'Temporary voice channels and server stats channels.' }) %>
<% if (modules.has('tempvoice')) { const T = settings.tempvoice; %>
<form class="card" method="post" action="<%= base %>/save/tempvoice">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <h3>🔊 Temporary voice channels</h3>
  <p class="hint">When a member joins the "hub" channel, the bot creates their own channel and moves them. The channel is deleted when it empties. The owner manages it with <code>/voice</code>.</p>
  <%- include('../partials/toggle', { name: 'enabled', checked: T.enabled, label: 'Enabled' }) %>
  <div class="grid2">
    <label>Hub channel ("Join to create")<%- include('../partials/channelSelect', { name: 'hub', value: T.hub, list: voiceChannels, voice: true, placeholder: '— choose a voice channel —' }) %></label>
    <label>Category for new channels<select name="category"><option value="">— same as hub —</option><% categories.forEach(c => { %><option value="<%= c.id %>" <%= T.category === c.id ? 'selected' : '' %>>📁 <%= c.name %></option><% }) %></select></label>
    <label>Channel name<input name="nameTemplate" maxlength="90" value="<%= T.nameTemplate %>"></label>
    <label>User limit (0 = none)<input type="number" name="userLimit" min="0" max="99" value="<%= T.userLimit %>"></label>
  </div>
  <button class="btn btn-primary">Save</button>
</form>
<% } %>
<% if (modules.has('serverstats')) { const S = settings.serverstats; const K = [['members','Members'],['humans','Ljudi'],['bots','Bots'],['boosts','Boostovi']]; %>
<form class="card" method="post" action="<%= base %>/save/serverstats">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="row between"><h3>📊 Stats channels</h3><button class="btn btn-ghost btn-sm" formaction="<%= base %>/serverstats/create">Create channels automatically</button></div>
  <p class="hint">Locked voice channels whose name shows a number. Refreshed every 10 minutes (Discord limit).</p>
  <%- include('../partials/toggle', { name: 'enabled', checked: S.enabled, label: 'Enabled' }) %>
  <% K.forEach(([k, l]) => { %>
    <div class="grid2">
      <label><%= l %> — channel<%- include('../partials/channelSelect', { name: k, value: S[k], list: voiceChannels, voice: true, placeholder: '— off —' }) %></label>
      <label>Name format<input name="<%= k %>Name" maxlength="90" value="<%= S[k + 'Name'] %>"></label>
    </div>
  <% }) %>
  <button class="btn btn-primary">Save</button>
</form>
<% } %>
<%- include('../partials/app-end') %>
