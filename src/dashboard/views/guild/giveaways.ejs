<%- include('../partials/app-start') %>
<%- include('../partials/pagehead', { heading: 'Giveaway', icon: 'gift', sub: 'Start a giveaway or manage existing ones.' }) %>
<div class="card">
  <h3>New giveaway</h3>
  <form method="post" action="<%= base %>/giveaways/create">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="grid2">
      <label>Prize<input name="prize" maxlength="200" required placeholder="Discord Nitro"></label>
      <label>Channel<%- include('../partials/channelSelect', { name: 'channel', value: '', required: true }) %></label>
      <label>Duration<input name="duration" required placeholder="1d, 12h, 30m"></label>
      <label>Number of winners<input type="number" name="winners" min="1" max="50" value="1"></label>
    </div>
    <button class="btn btn-primary">🎉 Start</button>
  </form>
</div>
<div class="card">
  <h3>Giveaways</h3>
  <% if (!giveawayList.length) { %><p class="muted">No giveaways.</p><% } else { %>
  <table class="table"><thead><tr><th>ID</th><th>Prize</th><th>Entrants</th><th>Ends</th><th>Winners</th><th></th></tr></thead><tbody>
    <% giveawayList.forEach(g => { %>
      <tr>
        <td><%= g.id %></td><td><%= g.prize %></td><td><%= g.entrants.length %></td>
        <td><%= g.ended ? 'ended' : new Date(g.ends_at).toLocaleString(numLocale) %></td>
        <td><%= g.winner_ids.map(userName).join(', ') || '—' %></td>
        <td class="actions">
          <% if (!g.ended) { %><form method="post" action="<%= base %>/giveaways/<%= g.id %>/end"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-xs">End</button></form><% } else { %>
          <form method="post" action="<%= base %>/giveaways/<%= g.id %>/reroll"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-ghost btn-xs">Reroll</button></form><% } %>
          <form method="post" action="<%= base %>/giveaways/<%= g.id %>/delete" data-confirm="Delete from the database?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger btn-xs">Delete</button></form>
        </td>
      </tr>
    <% }) %>
  </tbody></table><% } %>
</div>
<%- include('../partials/app-end') %>
