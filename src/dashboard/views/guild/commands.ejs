<%- include('../partials/app-start') %>
<%- include('../partials/pagehead', { heading: 'Custom commands & autoresponder', icon: 'terminal', sub: 'Commands with the prefix <code>' + settings.prefix + '</code> or automatic replies to keywords anywhere in the message.' }) %>

<div class="card">
  <h3>New command or autoresponder</h3>
  <form method="post" action="<%= base %>/commands/add">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="grid2">
      <label>Type<select name="matchType" id="cc-type">
        <option value="command">Prefix command (<%= settings.prefix %>trigger)</option>
        <option value="contains">Autoresponder — message contains word</option>
        <option value="exact">Autoresponder — message is exactly</option>
        <option value="startswith">Autoresponder — message starts with</option>
      </select></label>
      <label>Trigger<input name="trigger" id="cc-trigger" maxlength="100" required placeholder="pravila"></label>
    </div>
    <label>Response<textarea name="response" id="cc-response" rows="4" maxlength="2000"></textarea></label>
    <label>Emoji reaction (optional)<input name="reaction" id="cc-reaction" maxlength="64" placeholder="👋"></label>
    <%- include('../partials/placeholders', { extra: '<code>{args}</code> <code>{channel}</code>' }) %>
    <%- include('../partials/toggle', { name: 'embed', checked: false, label: 'Reply as an embed' }) %>
    <%- include('../partials/toggle', { name: 'deleteTrigger', checked: false, label: 'Delete the message that triggered the command' }) %>
    <button class="btn btn-primary">Save command</button>
  </form>
</div>
<div class="card">
  <h3>Existing (<%= customCommands.length %>)</h3>
  <% if (!customCommands.length) { %><p class="muted">No custom commands.</p><% } else { %>
  <table class="table"><thead><tr><th>Trigger</th><th>Response</th><th>Type</th><th>Used</th><th></th></tr></thead><tbody>
    <% customCommands.forEach(c => { %>
      <tr>
        <td><code><%= c.match_type === 'command' ? settings.prefix : '' %><%= c.trigger %></code></td>
        <td class="clip" title="<%= c.response %>"><%= c.response %></td>
        <td><span class="tag"><%= { command: 'command', contains: 'contains', exact: 'exact', startswith: 'starts' }[c.match_type] %></span><%= c.reaction ? ' ' + c.reaction : '' %></td>
        <td><%= c.uses %></td>
        <td class="actions">
          <button type="button" class="btn btn-ghost btn-xs" data-edit-cc data-trigger="<%= c.trigger %>" data-response="<%= c.response === '-' ? '' : c.response %>" data-type="<%= c.match_type %>" data-reaction="<%= c.reaction || '' %>">Uredi</button>
          <form method="post" action="<%= base %>/commands/<%= c.id %>/delete" data-confirm="Obrisati?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-danger btn-xs">Delete</button></form>
        </td>
      </tr>
    <% }) %>
  </tbody></table><% } %>
</div>
<%- include('../partials/app-end') %>
