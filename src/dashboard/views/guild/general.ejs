<%- include('../partials/app-start') %>
<%- include('../partials/pagehead', { heading: 'General', icon: 'settings', sub: 'Prefix, moderator role and enabled commands.' }) %>
<form method="post" action="<%= base %>/save/general">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="card">
    <h3>Basics</h3>
    <div class="grid2">
      <label>Prefix for custom commands<input name="prefix" value="<%= settings.prefix %>" maxlength="5"></label>
      <label>Moderator role <small class="muted">(info for the bot)</small><%- include('../partials/roleSelect', { name: 'modRole', value: settings.modRole, placeholder: '— none —' }) %></label>
    </div>
  </div>
  <div class="card">
    <h3>Enabled slash commands</h3>
    <p class="hint">Disabled commands reply with "this command is disabled". You can fine-tune command permissions in Discord: Server Settings → Integrations.</p>
    <div class="cmd-grid">
      <% commands.sort((a,b) => a.module.localeCompare(b.module) || a.name.localeCompare(b.name)).forEach(c => { %>
        <label class="cmd-item">
          <input type="checkbox" class="cmd-toggle" data-name="<%= c.name %>" <%= settings.disabledCommands.includes(c.name) ? '' : 'checked' %>>
          <span><b>/<%= c.name %></b><small><%= c.description %></small></span>
          <% if (settings.disabledCommands.includes(c.name)) { %><input type="hidden" name="disabledCommands" value="<%= c.name %>"><% } %>
        </label>
      <% }) %>
    </div>
  </div>
  <%- include('../partials/saveBar') %>
</form>
<%- include('../partials/app-end') %>
